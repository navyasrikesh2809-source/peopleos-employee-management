# Use a dedicated runtime role, not the migration/database owner.
DATABASE_URL="postgresql://ems_app:change-me@localhost:5432/ems?schema=public"
DIRECT_URL="postgresql://ems_migrator:change-me@localhost:5432/ems?schema=public"
REDIS_URL="redis://localhost:6379"

APP_URL="http://localhost:3000"
SESSION_COOKIE_NAME="ems_session"
SESSION_TTL_SECONDS="604800"

# Generate with: openssl rand -base64 32
DATA_ENCRYPTION_KEY="REPLACE_WITH_BASE64_32_BYTE_KEY"

# Seed-only demo credentials. Change before any shared deployment.
SEED_PASSWORD="ChangeMe-Local-Only-2026!"
